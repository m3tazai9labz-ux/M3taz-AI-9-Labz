# ==============================================
# M3ta'z A.I. 9 Labz — Telegram Integration
# ==============================================

# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Allowed Telegram User IDs (comma-separated)
# Find your user ID by messaging @userinfobot on Telegram
ALLOWED_USER_IDS=

# Allowed Telegram Group IDs (comma-separated)
# Groups: Lotus Group, Family, Personal
ALLOWED_GROUP_IDS=

# Database
DATABASE_URL=sqlite:///./m3taz_hub.db

# Web App
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8000
WEBAPP_SECRET_KEY=change-this-to-a-random-secret

# Media Storage
MEDIA_STORE_PATH=./media_store/uploads
THUMBNAIL_PATH=./media_store/thumbnails
MAX_FILE_SIZE_MB=50

# Twin.so AI Automation (https://twin.so)
TWIN_API_KEY=
TWIN_WEBHOOK_SECRET=

# Optional: Anthropic API for AI features
ANTHROPIC_API_KEY=

# Optional: Google Photos API
GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=

# Optional: Apple iCloud (via pyicloud)
APPLE_ID=
APPLE_PASSWORD=
