# ==============================================
# M3ta'z A.I. 9 Labz — Environment Variables
# ==============================================
# Copy to .env and fill in your values. Never commit .env to git.

# ── TELEGRAM ──────────────────────────────────
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Allowed Telegram User IDs (comma-separated). Leave empty to allow all (dev mode).
# Find your ID by messaging @userinfobot
ALLOWED_USER_IDS=

# Allowed Telegram Group IDs (comma-separated)
ALLOWED_GROUP_IDS=

# ── DISCORD ───────────────────────────────────
# Create bot at https://discord.com/developers/applications
# Required scopes: bot, applications.commands
# Required permissions: Send Messages, Read Message History, Use Slash Commands
DISCORD_BOT_TOKEN=

# ── SLACK ─────────────────────────────────────
# Create app at https://api.slack.com/apps
# Enable Socket Mode and add Bot Token Scopes: chat:write, im:read, im:history, channels:read
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=

# ── WHATSAPP (Meta Cloud API) ─────────────────
# Setup at https://developers.facebook.com/apps
# Requires a Meta Business account and WhatsApp Business product
WHATSAPP_TOKEN=your-whatsapp-bearer-token
WHATSAPP_PHONE_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=any-random-string-you-choose

# ── DATABASE ──────────────────────────────────
# SQLite (default, local dev):
DATABASE_URL=sqlite+aiosqlite:///./m3taz_hub.db
# SurrealDB (production):
# DATABASE_URL=surrealdb://root:root@localhost:8001/m3taz/main

# ── WEB APP ───────────────────────────────────
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8000
WEBAPP_SECRET_KEY=change-this-to-a-random-secret

# ── MEDIA STORAGE ─────────────────────────────
MEDIA_STORE_PATH=./media_store/uploads
THUMBNAIL_PATH=./media_store/thumbnails
MAX_FILE_SIZE_MB=50

# ── ANTHROPIC (Claude) ────────────────────────
# Used for intent classification and orchestration
# Get key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── OPEN WEBUI ────────────────────────────────
# Self-hosted chat UI and OpenAI-compatible API proxy
# Deploy: docker-compose up open-webui
OPEN_WEBUI_URL=http://localhost:3000
OPEN_WEBUI_API_KEY=

# ── EIGENT AI ─────────────────────────────────
# Multi-agent workforce (Developer, Browser, Document, Multi-Modal agents)
# Deploy: docker-compose up eigent
EIGENT_API_URL=http://localhost:7070
EIGENT_API_KEY=

# ── AGENT ZERO ────────────────────────────────
# Hierarchical agent framework — code execution, deep reasoning, persistent memory
# Deploy: docker run -p 50001:80 agent0ai/agent-zero
AGENT_ZERO_URL=http://localhost:50001
AGENT_ZERO_API_KEY=

# ── AFFINE ────────────────────────────────────
# All-in-one workspace — docs, whiteboards, databases (knowledge base)
# Deploy: docker-compose up affine
AFFINE_URL=http://localhost:3010
AFFINE_API_KEY=

# ── OPENCLAW ──────────────────────────────────
# Personal AI agent daemon — multi-platform messaging + skills engine
# Deploy: docker-compose up openclaw
OPENCLAW_API_URL=http://localhost:8080
OPENCLAW_API_KEY=

# ── OLLAMA ────────────────────────────────────
# Local model inference — runs LLMs on your machine (privacy-first)
# Install: https://ollama.com/download
# Deploy: docker-compose up ollama  OR  ollama serve
# Claude Code + Ollama: ollama launch claude
# Recommended models: qwen3-coder, glm-4.7, gpt-oss:20b, gpt-oss:120b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-coder
# For Claude Code to use Ollama local models, set these before running 'claude':
# ANTHROPIC_AUTH_TOKEN=ollama
# ANTHROPIC_BASE_URL=http://localhost:11434

# ── ANYTHINGLLM ───────────────────────────────
# RAG-powered document chat — each business context gets its own workspace
# Deploy: docker-compose up anythingllm
# Access UI: http://localhost:3001
# Get API key: Settings → API Keys inside the AnythingLLM UI
# Create workspaces: eagle-eye-vision-labz, lotus-group, metaos-q3bi, personal, family
ANYTHINGLLM_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_DEFAULT_WORKSPACE=personal

# ── OPTIONAL INTEGRATIONS ─────────────────────
GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=
APPLE_ID=
APPLE_PASSWORD=
